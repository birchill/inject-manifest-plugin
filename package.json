{
  "name": "@birchill/inject-manifest-plugin",
  "version": "1.0.2",
  "description": "rspack plugin to inject a manifest file into a service worker file",
  "repository": "https://github.com/birchill/inject-manifest-plugin/",
  "keywords": [
    "service worker",
    "manifest"
  ],
  "author": "Birchill, Inc.",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist/**"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "dependencies": {
    "fast-json-stable-stringify": "^2.1.0",
    "pretty-bytes": "^7.1.0",
    "schema-utils": "^4.3.3",
    "source-map": "^0.7.6",
    "webpack-sources": "^3.4.1"
  },
  "devDependencies": {
    "@release-it/conventional-changelog": "11.0.0",
    "@rspack/core": "2.0.2",
    "@types/node": "24.12.2",
    "husky": "9.1.7",
    "knip": "6.12.0",
    "lint-staged": "17.0.2",
    "prettier": "3.8.3",
    "release-it": "20.0.1",
    "tsdown": "0.21.10",
    "typescript": "6.0.3"
  },
  "peerDependencies": {
    "@rspack/core": ">=1.0.0"
  },
  "scripts": {
    "prepublishOnly": "pnpm build",
    "build": "tsdown",
    "release": "release-it",
    "prepare": "husky"
  },
  "engines": {
    "pnpm": ">=11"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "engines": {}
  }
}
